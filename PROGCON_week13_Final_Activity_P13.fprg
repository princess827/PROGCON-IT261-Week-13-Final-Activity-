<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="PROGCON_week13_Final_Project_P13"/>
        <attribute name="authors" value="riri"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-09 09:51:37 PM"/>
        <attribute name="created" value="cmlyaTtMQVBUT1AtQlJSOEhPRTM7MjAyNi0xMC0wOTswODo1OTowMCBQTTsyNzkw"/>
        <attribute name="edited" value="cmlyaTtMQVBUT1AtQlJSOEhPRTM7MjAyNi0xMC0wOTswOTo1MTozNyBQTTsxOzI5MDE="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="difficulty" type="Integer" array="False" size=""/>
            <declare name="playAgain" type="String" array="False" size=""/>
            <do expression="playAgain == &quot;Y&quot; OR playAgain==&quot;y&quot;">
                <output expression="&quot;Select Difficulty: 1(easy), 2(medium), 3(hard)&quot;" newline="True"/>
                <input variable="difficulty"/>
                <call expression="playGame(difficulty)"/>
                <output expression="&quot;Play Again? (Y/N)&quot;" newline="True"/>
                <input variable="playAgain"/>
            </do>
            <output expression="&quot;Thank you for playing!&quot;" newline="True"/>
        </body>
    </function>
    <function name="playGame" type="None" variable="">
        <parameters>
            <parameter name="difficulty" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="maxNumber, secretNumber, guess, attempts" type="Integer" array="False" size=""/>
            <if expression="difficulty ==1">
                <then>
                    <assign variable="maxNumber" expression="10"/>
                </then>
                <else>
                    <if expression="difficulty == 2">
                        <then>
                            <assign variable="maxNumber" expression="50"/>
                        </then>
                        <else>
                            <if expression="difficulty == 3">
                                <then>
                                    <assign variable="maxNumber" expression="100"/>
                                </then>
                                <else>
                                    <output expression="&quot;Pick a valid option&quot;" newline="True"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <assign variable="secretNumber" expression="Random(maxNumber)+1"/>
            <assign variable="attempts" expression="0"/>
            <do expression="guess != secretNumber">
                <output expression="&quot;Enter your guess (1 to &quot; &amp; maxNumber &amp; &quot;):&quot;" newline="True"/>
                <input variable="guess"/>
                <assign variable="attempts" expression="attempts +1"/>
                <if expression="guess &lt; secretNumber">
                    <then>
                        <output expression="&quot;Too low! Try Again&quot;" newline="True"/>
                    </then>
                    <else>
                        <if expression="guess &gt; secretNumber">
                            <then>
                                <output expression="&quot;Too high! Try again&quot;" newline="True"/>
                            </then>
                            <else/>
                        </if>
                    </else>
                </if>
            </do>
            <output expression="&quot;Correct! You got it in &quot; &amp; attempts &amp; &quot; tries.&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
